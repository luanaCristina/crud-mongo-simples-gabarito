<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>// ALUNOS_DB // Cadastro 2077</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>&gt;_ ALUNOS_DB // 2077</h1>
            <p>SISTEMA DE CADASTRO ACADÊMICO &bull; NIGHT CITY TECH SCHOOL</p>
        </header>

        <div class="toolbar">
            <a href="/novo" class="btn btn-primary">+ Novo Aluno</a>
            <!-- Botao de navegacao para a API original (roda na porta 3000) -->
            <a href="http://localhost:3000/show" class="btn btn-ghost">&gt; Ir para API de Pessoas (3000)</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Escola</th>
                    <th>Curso</th>
                    <th>Matrícula</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (alunos.length === 0) { %>
                    <tr>
                        <td colspan="6" class="vazio">// NENHUM ALUNO CADASTRADO //</td>
                    </tr>
                <% } else { %>
                    <% alunos.forEach(function(aluno) { %>
                        <tr>
                            <td><%= aluno.nome %></td>
                            <td class="email"><%= aluno.email %></td>
                            <td><%= aluno.escola %></td>
                            <td><span class="badge"><%= aluno.curso %></span></td>
                            <td><%= aluno.matricula %></td>
                            <td class="acoes">
                                <a href="/detalhes/<%= aluno._id %>" class="btn btn-primary btn-sm">Detalhes</a>
                                <a href="/editar/<%= aluno._id %>" class="btn btn-cyan btn-sm">Editar</a>
                                <a href="/deletar/<%= aluno._id %>" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Deletar este aluno?')">Deletar</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>

        <footer>// WAKE THE F*CK UP SAMURAI, WE HAVE A DATABASE TO BURN //</footer>
    </div>
</body>

</html>
